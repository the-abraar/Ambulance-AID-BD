DOMAIN=dispatch.example.org
# Generate each with `openssl rand -hex 32`. The db service refuses to start with these placeholders,
# with values shorter than 24 characters, or with characters other than letters and digits (they go into URLs).
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# Never set AMBULANCE_DEV here: it is for a developer laptop only.
